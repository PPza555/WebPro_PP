<!-- home.ejs -->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>home</title>
    <link rel="stylesheet" href="/css/home.css">
</head>

<body>

    <div class="container">
        <h1>Bookstore Management</h1>
        <div class="div_add">
            <div class="add">
                <a href="/add" class="add">+ เพิ่มหนังสือ</a><br><br>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>ชื่อหนังสือ</th>
                    <th>ผู้แต่ง</th>
                    <th>หมวดหมู่</th>
                    <th>ราคา</th>
                    <th style="text-align: center;">จำนวนในสต๊อก</th>
                    <th style="text-align: center;">จัดการ</th>
                </tr>
            </thead>
            <tbody>
                <% data.forEach(item=> { %>
                    <tr>
                        <td>
                            <%= item.book_id %>
                        </td>
                        <td>
                            <%= item.book_name %>
                        </td>
                        <td>
                            <%= item.author %>
                        </td>
                        <td>
                            <%= item.category %>
                        </td>
                        <td>
                            <%= item.price %>
                        </td>
                        <td style="text-align: center;">
                            <%= item.stock %>
                        </td>
                        <td>
                            <div class="home_button">
                                <a href="/edit/<%= item.book_id %>" class="edit">แก้ไข</a>
                                <a href="/delete/<%= item.book_id %>" class="delete">ลบ</a>
                            </div>
                        </td>
                    </tr>
                    <% }); %>

            </tbody>
        </table>

    </div>

</body>

</html>