<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>detail</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>
<body>
    <div class="container w-50 my-5">
            
        <div class="card shadow border-0 p-3">
            <h2 class="card-title m-2 mb-3">
                Product <%= data.product_id %> Detail
            </h2>

            <img class="card-img img-fluid" src="<%= data.image_url %>">
            
            <h3 class="card-title mx-2 mt-4">
                <%= data.name %>
            </h3>

            <p class="card-text text-muted mx-2 mb-2">
                Description: <%= data.description %>
            </p>

            <p class="card-text m-2 mt-4 mb-2">
                Price: <%= data.price %>
            </p>

            <p class="card-text m-2 mb-4">
                Amount: <%= data.quantity %>
            </p>

            <a class="btn btn-primary w-100 mt-auto mb-2" href="/">Go Back</a>
        
        </div>
    </div>

</body>
</html>