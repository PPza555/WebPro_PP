<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>restarant</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="css/style.css">

</head>
<body>
    <div class="container py-5">
        <h1 class="text-center mb-5">My Products 🍽️</h1>
        
        <div class="container mt-5">
            <div class="row g-3">

                <% data.forEach((item)=> { %>
                    <div class="col-lg-3 col-md-6">
                        <div class="card h-100 shadow border-0">

                            <div class="card-body d-flex flex-column">
                                <div class="img-container">
                                    <img class="card-img img-fluid custom-img"
                                    src="<%= item.image_url %>">
                                </div>

                                <h3 class="card-title m-1 mt-4">
                                    <%= item.name %>
                                </h3>

                                <p class="card-text text-muted m-1 mb-4">
                                    <%= item.description %>
                                </p>

                                <a class="btn btn-primary w-100 mt-auto" href="/detail/<%= item.product_id %>">Detail</a>

                            </div>
                        </div>
                    </div>

                <% }); %>

            </div>
        </div>
    </div>




</body>
</html>