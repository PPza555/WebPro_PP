<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>list of emplyees</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="bg-light">
    <div class="container py-5">
        <h1 class="text-center mb-5"> list of emplyees </h1>

        <div class="container mt-5">
            <div class="row g-4">

                <% data.forEach((item)=> { %>

                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 shadow-sm border-0">

                            <div class="card-body">
                                <span class="badge bg-primary mb-2">
                                    ID: <%= item.EmployeeID %>
                                </span>

                                <h4 class="card-title">
                                    <%= item.Brand %>
                                </h4>

                                <img class="card-img-top" style="height: 250px; object-fit: contain;"
                                    src="http://webdev.it.kmitl.ac.th:4000/emp-images/<%= item.EmployeeID %>.png">

                                <p class="card-text text-muted">
                                    <b>First Name:</b>
                                    <%= item.FirstName %>
                                </p>

                                <p class="card-text text-muted">
                                    <b>Last Name:</b>
                                    <%= item.LastName %>
                                </p>
                            </div>

                        </div>
                    </div>

                    <% }); %>

            </div>
        </div>

</body>

</html>