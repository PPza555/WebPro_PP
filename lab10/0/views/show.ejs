<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>smartphone details</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="bg-light"> <div class="container py-5"> <h1 class="text-center mb-5"> 📱 Smartphone Store </h1>

    <div class="container mt-5">
        <div class="row g-4">

            <% data.forEach((item)=> { %>

                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body">
                            <span class="badge bg-primary mb-2">
                                ID: <%= item.id %>
                            </span>

                            <h4 class="card-title">
                                <%= item.Brand %>
                            </h4>

                            <img  class="card-img-top"  style="height: 250px; object-fit: contain;" src="https://s.alicdn.com/@sc04/kf/Hfa1122a7df3c4e77bf2ba5b45a93dec9g/Educational-Smart-Phone-Toys-Birthday-Game-Phone-for-Kids-With-CMOS-Imaging-Sensor-and-MP3-Functionality.jpg">

                            <p class="card-text text-muted">
                                <b>Model:</b> <%= item.Model %>
                            </p>

                            <p class="card-text text-muted">
                                <b>RAM:</b> <%= item.RAM %>
                            </p>

                            <p class="card-text text-muted">
                                <b>Rear Camera:</b> <%= item.RearCamera %>
                            </p>

                            <p class="card-text text-muted">
                                <b>Front Camera:</b> <%= item.FrontCamera %>
                            </p>

                            <p class="card-text text-muted">
                                <b>Price:</b> <%= item.Price %> บาท
                            </p>
                        </div>

                    </div>
                </div>

                <% }); %>

        </div>
    </div>

</body>

</html>